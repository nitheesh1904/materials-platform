
print "Starting XY shear deformation"
Starting XY shear deformation

variable xy0 equal $(xy)
variable xy0 equal 0

# Maximum shear strain
variable strainxy equal 0.02

# Engineering shear strain:
#
# gamma_xy = Delta(xy) / Ly
#
variable ly0 equal $(ly)
variable ly0 equal 54.30952043287079789

variable ilx equal lx
variable ily equal ly
variable ilz equal lz

variable exy equal xy/${ily}
variable exy equal xy/54.3095204328708

variable exz equal xz/${ilz}
variable exz equal xz/108.619040865742

variable eyz equal yz/${ilz}
variable eyz equal yz/108.619040865742

variable exx equal (lx-${ilx})/${ilx}
variable exx equal (lx-54.3095204328708)/${ilx}
variable exx equal (lx-54.3095204328708)/54.3095204328708

variable eyy equal (ly-${ily})/${ily}
variable eyy equal (ly-54.3095204328708)/${ily}
variable eyy equal (ly-54.3095204328708)/54.3095204328708

variable ezz equal (lz-${ilz})/${ilz}
variable ezz equal (lz-108.619040865742)/${ilz}
variable ezz equal (lz-108.619040865742)/108.619040865742


variable xy_final equal v_xy0 + v_strainxy*v_ly0



# Shear strain
variable exy equal (xy-v_xy0)/v_ly0



# Stress tensor
compute stressxy all pressure NULL virial

# Apply XY shear deformation
fix defxy all deform 1 xy final $(v_xy_final) units box
fix defxy all deform 1 xy final 1.0861904086574198924 units box

thermo          100
thermo_style    custom step time c_stressxy[1] v_ezz  c_stressxy[2] v_eyy c_stressxy[3] v_ezz c_stressxy[4] v_exy c_stressxy[5] v_exz c_stressxy[6] v_eyz lx ly lz xy

