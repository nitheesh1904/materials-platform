
# ------------------ Initialization ------------------
units           metal
boundary        p p p
atom_style      atomic

# ------------------ Geometry Generation -------------
# Silicon diamond cubic lattice constant is 5.431 Angstroms

variable pwd_path getenv PWD

variable structure_file string ../structures/si_structure.txt

variable first_run_step equal ${steps}  

variable structure_file_name string ${structure_file_path}si_structure_${lattice_constant}.txt

read_data ${structure_file_name}


# Create directory 

shell mkdir ${run_dir}/results/lattice_parameter


# ------------------ Interatomic Potential -----------------
# Using the standard Stillinger-Weber (SW) potential
pair_style      sw
pair_coeff      * * ${potential_path} Si


# ------------------ Compute -----------------
compute eng all pe/atom 	
compute eatoms all reduce sum c_eng  
compute new all temp  


# ------------------ Energy Minimization -------------
# Relax the structure to remove any initial overlapping/strain
thermo          10
thermo_style    custom step temp pe press vol

minimize 1.0e-6 1.0e-6 5000 10000

# ------------------ Equilibration (NVT/NPT) ---------
reset_timestep  0
velocity all create ${temperature} 87287 loop geom

# ---------- Timestamp Details ----------
# Reference timestep for metal units with Silicon is typically 1-2 fs
timestep        0.001 


# -------------------- 0 K Static Calculation --------------------

if "${temperature} == 0" then "jump SELF static"


# ---------- NPT Fix ----------

# Tdamp - 100*Timestep
# Pdamp - 1000*Timestep

fix 1 all npt temp ${temperature} ${temperature} 0.1 iso ${pressure} ${pressure} 1.0

# ---------- Dump Details ----------
variable dump_path string ${run_dir}/results/lattice_parameter/si_out_${temperature}.dat

dump 1 all custom 5000 ${dump_path} mass type xs ys zs

dump_modify 1 sort id

# ---------- Equilibration ----------
run ${first_run_step}

# ---------- Average box dimensions ----------

variable sample_interval equal 100
variable nsamples equal ${first_run_step}/${sample_interval}

variable Lx equal lx
variable Ly equal ly
variable Lz equal lz

variable Etot equal pe
variable Ecoh equal c_eatoms/count(all)
variable Temp equal temp
variable Press equal press
variable Vol equal vol
variable natoms equal count(all)

fix avg all ave/time ${sample_interval} ${nsamples} ${first_run_step} v_Lx v_Ly v_Lz v_Etot v_Ecoh v_Temp v_Press v_Vol v_natoms file ${run_dir}/results/lattice_parameter/box_average_${temperature}.dat

# ---------- Production ----------
run ${first_run_step}

jump SELF end

# ----------------- 0 K simulation ----------

label static

print "Running 0 K static calculation"

thermo          10
thermo_style    custom step temp pe press vol

# Relaxing the box allows atoms to go to their equilibrium positions

fix 1 all box/relax iso 0.0 vmax 0.001

min_style cg
minimize 1.0e-6 1.0e-6 5000 100000
variable Etot equal pe
variable Vol equal vol
variable Press equal press


variable a_x equal lx/${xdim}
variable a_y equal ly/${ydim}
variable a_z equal lz/${zdim}

variable a_eq equal (v_a_x+v_a_y+v_a_z)/3.0


print "Lattice_parameter Volume Total_enregy Pressure" append ${run_dir}/results/lattice_parameter/box_average_${temperature}.dat
print "${a_eq} ${Vol} ${Etot} ${Press}" append ${run_dir}/results/lattice_parameter/box_average_${temperature}.dat

label end

print "Lattice parameter simulation completed for Si at ${temperature} K."
