
# ------------------ Initialization ------------------
units           metal
boundary        p p p
atom_style      atomic

# ------------------ Geometry Generation -------------
# Silicon diamond cubic lattice constant is 5.431 Angstroms

variable pwd_path getenv PWD

variable structure_file string ../structures/si_structure.txt

variable first_run_step equal ${steps}  

read_data ../structures/si_structure.txt

# ------------------ Interatomic Potential -----------------
# Using the standard Stillinger-Weber (SW) potential
pair_style      sw
pair_coeff      * * ../potentials/Si.sw Si


# ------------------ Compute -----------------
compute eng all pe/atom 	
compute eatoms all reduce sum c_eng  
compute new all temp  


# ------------------ Energy Minimization -------------
# Relax the structure to remove any initial overlapping/strain
thermo          10
thermo_style    custom step temp pe press vol

minimize 1.0e-6 1.0e-6 5000 10000

# ------------------ Equilibration (NVT/NPT) ---------
reset_timestep  0
velocity all create ${temperature} 87287 loop geom

# ---------- Timestamp Details ----------
# Reference timestep for metal units with Silicon is typically 1-2 fs
timestep        0.001 



# ---------- NPT Fix ----------

# Tdamp - 100*Timestep
# Pdamp - 1000*Timestep

fix 1 all npt temp ${temperature} ${temperature} 0.1 iso ${pressure} ${pressure} 1.0

# ---------- Dump Details ----------
variable dump_path string "../results/lattice_parameter/si_out_${temperature}.dat"

dump 1 all custom 5000 ${dump_path} mass type xs ys zs

dump_modify 1 sort id

# ---------- Equilibration ----------
run ${first_run_step}

# ---------- Average box dimensions ----------

variable sample_interval equal 100
variable nsamples equal ${first_run_step}/${sample_interval}

variable Lx equal lx
variable Ly equal ly
variable Lz equal lz

variable Etot equal pe
variable Ecoh equal c_eatoms/count(all)
variable Temp equal temp
variable Press equal press
variable Vol equal vol
variable natoms equal count(all)

fix avg all ave/time ${sample_interval} ${nsamples} ${first_run_step} v_Lx v_Ly v_Lz v_Etot v_Ecoh v_Temp v_Press v_Vol v_natoms file ../results/lattice_parameter/box_average_${temperature}.dat

# ---------- Production ----------
run ${first_run_step}

print "Lattice parameter simulation completed for Si at ${temperature} K."
