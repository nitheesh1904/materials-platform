# ------------------ Equilibration (NVT/NPT) ---------
reset_timestep  0
velocity all create ${temperature} 87287 loop geom
velocity all create 500 87287 loop geom

# Reference timestep for metal units with Silicon is typically 1-2 fs
timestep        0.001


# Tdamp - 100*Timestep
# Pdamp - 1000*Timestep
#
# Run NPT to fix temperature at 300K and pressure at 0 Bar
fix 1 all npt temp ${temperature} ${temperature} 0.1 iso ${pressure} ${pressure} 1.0
fix 1 all npt temp 500 ${temperature} 0.1 iso ${pressure} ${pressure} 1.0
fix 1 all npt temp 500 500 0.1 iso ${pressure} ${pressure} 1.0
fix 1 all npt temp 500 500 0.1 iso 0.0 ${pressure} 1.0
fix 1 all npt temp 500 500 0.1 iso 0.0 0.0 1.0

