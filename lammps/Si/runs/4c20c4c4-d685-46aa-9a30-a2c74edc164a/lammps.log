variable structure_file string ../structures/si_structure.txt

variable first_run_step equal ${steps}
variable first_run_step equal 50000

variable structure_file_name string ${structure_file_path}si_structure_${lattice_constant}.txt
variable structure_file_name string ../structures/si_structure_${lattice_constant}.txt
variable structure_file_name string ../structures/si_structure_5.43.txt

read_data ${structure_file_name}
read_data ../structures/si_structure_5.43.txt
